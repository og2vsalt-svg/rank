{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "framework": "vite",
  "rewrites": [
    {
      "source": "/api/gate",
      "destination": "/api/gate"
    },
    {
      "source": "/api/:name",
      "destination": "/api/gate?name=:name"
    },
    {
      "source": "/((?!api/|assets/).*)",
      "destination": "/index.html"
    }
  ]
}