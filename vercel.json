{
  "rewrites": [
    { "source": "/s/:id", "destination": "/api/embed?id=:id" },
    { "source": "/f/:id", "destination": "/api/embed?id=:id" },
    { "source": "/open/:id", "destination": "/api/embed?id=:id" },
    { "source": "/go/:id", "destination": "/api/embed?id=:id" },
    { "source": "/link/:id", "destination": "/api/embed?id=:id" },
    { "source": "/x/:id", "destination": "/api/embed?id=:id" },
    { "source": "/d/:id", "destination": "/api/embed?id=:id" },
    { "source": "/h/:id", "destination": "/api/embed?id=:id" },
    { "source": "/p/:page", "destination": "/api/embed?page=:page" },
    { "source": "/page/:page", "destination": "/api/embed?page=:page" }
  ],
  "headers": [
    {
      "source": "/api/(.*)",
      "headers": [
        { "key": "Access-Control-Allow-Origin", "value": "*" },
        { "key": "Access-Control-Allow-Methods", "value": "GET,POST,OPTIONS" }
      ]
    }
  ]
}
