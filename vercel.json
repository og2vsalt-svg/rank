{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "framework": "vite",
  "rewrites": [
    {
      "source": "/api/gate",
      "destination": "/api/gate"
    },
    {
      "source": "/api/:name",
      "destination": "/api/gate?name=:name"
    },
    {
      "source": "/lorgnette/:id",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": "(?i).*(discord|twitterbot|facebookexternalhit|slackbot|telegrambot|whatsapp|linkedinbot|redditbot|embedly|iframely|applebot).*"
        }
      ],
      "destination": "/api/gate?name=lorgnette&page=lorgnette&id=:id&card=1"
    },
    {
      "source": "/lorgnette",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": "(?i).*(discord|twitterbot|facebookexternalhit|slackbot|telegrambot|whatsapp|linkedinbot).*"
        }
      ],
      "destination": "/api/gate?name=lorgnette&page=lorgnette&card=1"
    },
