{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "framework": "vite",
  "functions": {
    "api/gate.js": {
      "maxDuration": 60
    }
  },
  "rewrites": [
    { "source": "/api/:desk", "destination": "/api/gate?desk=:desk" },
    { "source": "/api/:desk/:id", "destination": "/api/gate?desk=:desk&id=:id" },
    { "source": "/((?!api/|assets/).*)", "destination": "/index.html" }
  ]
}
